10 REM PRIFLOP HUNG-C64 TEST (STEP 13B, DECISION 11B) - TOOLS/HUNGTEST.S
20 PRINT CHR$(147);"HUNGTEST: THE C64 FREEZES MID-BYTE"
30 PRINT "FOR ABOUT 20 SECONDS. SCREEN STAYS."
40 FOR I=0 TO 43:READ V:POKE 49152+I,V:NEXT
50 OPEN 15,8,15
60 OPEN 2,8,2,"IECTEST*"
70 INPUT#15,EN,EM$,ET,ES
80 PRINT "OPEN   ";EN;EM$
90 IF EN<>0 THEN PRINT "CANNOT OPEN IECTEST":GOTO 200
100 PRINT "HOLDING THE BUS ..."
110 SYS 49152
120 PRINT "RELEASED"
200 CLOSE 2
210 INPUT#15,EN,EM$,ET,ES
220 PRINT "STATUS ";EN;EM$
230 CLOSE 15
240 PRINT "HUNGTEST DONE"
