10 REM PRIFLOP IMAGE TEST - D64 D71 D81 DNP
20 PRINT CHR$(147);"IMAGE FORMAT TEST"
30 PRINT "-----------------"
40 TF=0:TS=0
50 OPEN 15,8,15
60 GOSUB 900
70 PRINT "STATUS ";E$
80 IF EN<>0 AND EN<>73 THEN TF=TF+1
90 READ IM$,PF$,FM
100 IF IM$="END" THEN 800
110 PRINT
120 PRINT "== ";IM$
130 F=0:SK=0
140 PRINT " MOUNT  ";
150 PRINT#15,"CD:"+IM$
160 GOSUB 900
170 PRINT E$
180 IF EN<>0 THEN TF=TF+1:GOTO 90
190 IF PF$="" THEN 260
200 PRINT " INREAD ";
210 OPEN 2,8,2,"0:"+PF$+",P,R"
220 GOSUB 900
230 N=0
240 IF EN<>0 THEN PRINT E$:F=1:GOTO 255
242 GET#2,A$
244 IF ST=0 THEN N=N+1:GOTO 242
246 PRINT N;"BYTES"
248 IF N<100 THEN F=1
255 CLOSE 2
260 IF FM=0 THEN 300
265 PRINT " FORMAT ";
270 PRINT#15,"N0:TESTIMG,99"
280 GOSUB 900
290 PRINT E$
295 IF EN=72 THEN SK=1:GOTO 680
296 IF EN<>0 THEN F=1
300 PRINT " WRITE  ";
310 OPEN 2,8,2,"@0:IMGSEQ,S,W"
320 FOR I=1 TO 20
330 PRINT#2,"LINE"+STR$(I)
340 NEXT
350 CLOSE 2
360 GOSUB 900
370 PRINT E$
380 IF EN<>0 THEN F=1
390 PRINT " VERIFY ";
400 OPEN 2,8,2,"0:IMGSEQ,S,R"
410 N=0
420 FOR I=1 TO 20
430 INPUT#2,A$
440 IF A$<>"LINE"+STR$(I) THEN N=N+1
450 NEXT
460 CLOSE 2
470 IF N=0 THEN PRINT "OK"
480 IF N>0 THEN PRINT "BAD LINES";N:F=1
490 PRINT " DIR    ";
500 OPEN 1,8,0,"$"
510 N=0
520 GET#1,A$
530 IF ST=0 THEN N=N+1:GOTO 520
540 CLOSE 1
550 PRINT N;"BYTES"
560 IF N<32 THEN F=1
570 PRINT " SCRATCH";
580 PRINT#15,"S0:IMGSEQ"
590 GOSUB 900
600 PRINT E$
610 IF EN<>1 THEN F=1
620 PRINT " GONE   ";
630 OPEN 2,8,2,"0:IMGSEQ,S,R"
640 GOSUB 900
650 CLOSE 2
660 IF EN=62 THEN PRINT "OK"
670 IF EN<>62 THEN PRINT "UNEXPECTED ";E$:F=1
680 PRINT " UNMOUNT";
690 PRINT#15,"CD:"+CHR$(95)
700 GOSUB 900
710 PRINT E$
720 IF EN<>0 THEN F=1
725 IF SK=1 THEN PRINT " ---> SKIPPED, NOT ENOUGH FREE SPACE":TS=TS+1:GOTO 750
730 IF F=0 THEN PRINT " ---> PASS"
740 IF F>0 THEN PRINT " ---> FAIL":TF=TF+1
750 GOTO 90
800 PRINT
810 PRINT "HOST VOL ";
820 OPEN 1,8,0,"$"
830 N=0
840 GET#1,A$
850 IF ST=0 THEN N=N+1:GOTO 840
860 CLOSE 1
870 PRINT N;"BYTES"
875 IF N<32 THEN TF=TF+1:PRINT "HOST DIR FAILED"
880 CLOSE 15
885 PRINT
886 IF TS>0 THEN PRINT TS;"SKIPPED - FREE SPACE ON THE DRIVE"
888 IF TS>0 THEN PRINT "AND RUN AGAIN TO COVER THEM"
890 IF TF=0 THEN PRINT "ALL IMAGE TESTS PASSED"
895 IF TF>0 THEN PRINT TF;"IMAGE TEST(S) FAILED"
897 END
900 INPUT#15,EN,EM$,ET,ES
910 E$=STR$(EN)+" "+EM$
920 RETURN
1000 REM NAME, FILE TO READ INSIDE IT (OR NONE), FORMAT IT?
1002 REM A FORMAT REWRITES THE WHOLE IMAGE, AND LITTLEFS IS
1004 REM COPY ON WRITE - SO FORMATTING THE 800K D81 NEEDS
1006 REM 800K FREE ON TOP OF THE IMAGE ITSELF. IF THAT IS
1008 REM NOT THERE THE DRIVE SAYS 72 DISK FULL AND THE TEST
1010 REM REPORTS SKIPPED, NOT FAILED.
1012 REM TESTDISK.D64 IS NOT FORMATTED - IT HOLDS IECTEST,
1014 REM WHICH THE INREAD STEP CHECKS AND A FORMAT WOULD ERASE
1030 DATA "TESTDISK.D64","IECTEST",0
1040 DATA "TEST.D64","",1
1050 DATA "TEST71.D71","",1
1060 DATA "TEST.DNP","",1
1070 DATA "TEST81.D81","",1
1080 DATA "END","",0
