10 REM MICRO TEST: BLOCK SAVE, VARTAB-SAFE VERSION
11 REM DRIVE 8, FILE=FILL, SIZE=508 BYTES (2 CBM BLOCKS)
14 POKE 55,0:POKE 56,64:CLR
15 POKE 828,PEEK(43):POKE 829,PEEK(44):POKE 830,PEEK(45):POKE 831,PEEK(46)
16 BUF=16384:FS=508
20 PRINT CHR$(147);"SAVE/READ MICRO TEST"
30 PRINT "FILLING ";FS;" BYTES..."
40 FOR I=0 TO FS-1:POKE BUF+I,I AND 255:NEXT I
50 PRINT "FILL DONE"
60 BL=BUF-INT(BUF/256)*256:BH=INT(BUF/256)
70 EA=BUF+FS:EL=EA-INT(EA/256)*256:EH=INT(EA/256)
80 PRINT "START=";BUF;" END=";EA
85 PRINT "BL=";BL;" BH=";BH;" EL=";EL;" EH=";EH
87 POKE 832,BL:POKE 833,BH:POKE 834,EL:POKE 835,EH
91 POKE 45,PEEK(834)
92 PRINT "45 OK"
93 POKE 46,PEEK(835)
94 PRINT "46 OK"
95 POKE 43,PEEK(832)
96 PRINT "43 OK"
97 POKE 44,PEEK(833)
98 PRINT "44 OK"
100 SAVE "FILL",8
110 PRINT "SAVE RETURNED"
120 POKE 43,PEEK(828):POKE 44,PEEK(829):POKE 45,PEEK(830):POKE 46,PEEK(831)
130 PRINT "POINTERS RESTORED"
140 OPEN 15,8,15
150 INPUT#15,EN,EM$,ET,ES
160 PRINT "STATUS: ";EN;" ";EM$
170 PRINT "READING BACK..."
180 OPEN 2,8,2,"FILL,S,R"
185 GET#2,A$:GET#2,A$
190 ER=0
200 FOR I=0 TO FS-1
210 GET#2,A$:B=0:IF A$<>"" THEN B=ASC(A$)
220 IF B<>(I AND 255) THEN ER=ER+1
230 NEXT I
240 CLOSE 2
250 CLOSE 15
260 PRINT "READBACK MISMATCHES: ";ER
270 IF ER=0 THEN PRINT "ROUND TRIP OK"
280 IF ER>0 THEN PRINT "MISMATCH DETECTED"
290 PRINT "FILE LEFT ON DISK -- CHECK THE WEB UI"
300 END
