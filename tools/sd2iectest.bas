10 REM PRIFLOP IEC SELF TEST
20 REM DRIVE 8 OR 9 (RAM), FILE SIZE, ONE ROUND OR A LOOP
30 D=8:S=200:L=0:H=1
40 GOSUB 3000
50 R=0:P=0:Q=0:FR=0:F1$="":TS=TI
60 R=R+1:T1=TI
70 PRINT CHR$(147);"IECTEST DRIVE";D;" LINES";S
80 IF L=1 THEN PRINT "ROUND";R;" OK";P;" FAILED";Q
90 PRINT "-----------------"
100 GOSUB 1000
110 T2=INT((TI-T1)/60)
120 IF F=0 THEN P=P+1
130 IF F>0 THEN Q=Q+1:IF Q=1 THEN FR=R:F1$=F$
140 PRINT
150 IF F=0 THEN PRINT "ALL TESTS PASSED";
160 IF F>0 THEN PRINT F;"TEST(S) FAILED";
170 PRINT "  (";T2;"S)"
180 IF L=0 THEN END
190 IF F>0 AND H=1 THEN 400
200 PRINT "Q STOPS, ANY OTHER KEY OR 3 S GOES ON"
210 GOSUB 3500
220 IF K$="Q" THEN 400
230 GOTO 60
400 REM ---- LOOP SUMMARY ----
410 PRINT
420 PRINT "ROUNDS";R;" OK";P;" FAILED";Q
430 PRINT "TIME";INT((TI-TS)/60);"S"
440 IF Q>0 THEN PRINT "FIRST FAILURE: ROUND";FR;" STEP ";F1$
450 IF F>0 AND H=1 AND (F$="3" OR F$="5") THEN PRINT "FILES KEPT"
460 END
900 INPUT#15,EN,EM$,ET,ES
910 E$=STR$(EN)+" "+EM$
920 RETURN
1000 REM ---- ONE ROUND: F = FAILURES, F$ = FIRST FAILED STEP ----
1010 F=0:F$=""
1020 OPEN 15,D,15
1030 GOSUB 900
1040 PRINT "1 STATUS  ";E$
1050 IF EN<>0 AND EN<>73 THEN F=F+1:F$="1"
1060 PRINT#15,"S0:TESTSEQ":GOSUB 900
1070 PRINT#15,"S0:TESTBIG":GOSUB 900
1100 REM ---- WRITE SEQUENTIAL ----
1110 PRINT "2 WRITE   ";
1120 OPEN 2,D,2,"@0:TESTSEQ,S,W"
1130 FOR I=1 TO 50
1140 PRINT#2,"LINE"+STR$(I)
1150 NEXT
1160 CLOSE 2
1170 GOSUB 900
1180 PRINT E$
1190 IF EN<>0 THEN F=F+1:IF F$="" THEN F$="2"
1200 REM ---- READ BACK AND VERIFY ----
1210 PRINT "3 VERIFY  ";
1220 OPEN 2,D,2,"0:TESTSEQ,S,R"
1230 N=0
1240 FOR I=1 TO 50
1250 INPUT#2,A$
1260 IF A$<>"LINE"+STR$(I) THEN N=N+1:IF N=1 THEN B$=A$
1270 NEXT
1280 CLOSE 2
1290 IF N=0 THEN PRINT "OK"
1300 IF N>0 THEN PRINT "BAD LINES";N:F=F+1:IF F$="" THEN F$="3"
1310 IF N>0 THEN PRINT "  GOT:[";B$;"]"
1320 IF N>0 AND H=1 AND L=1 THEN 1890
1400 REM ---- BIG FILE ----
1410 PRINT "4 BIGWRITE";
1420 OPEN 2,D,2,"@0:TESTBIG,S,W"
1430 FOR I=1 TO S
1440 PRINT#2,"0123456789012345678901234567890123456789"
1450 NEXT
1460 CLOSE 2
1470 GOSUB 900
1480 PRINT " ";E$
1490 IF EN<>0 THEN F=F+1:IF F$="" THEN F$="4"
1500 PRINT "5 BIGREAD ";
1510 OPEN 2,D,2,"0:TESTBIG,S,R"
1520 N=0
1530 FOR I=1 TO S
1540 INPUT#2,A$
1550 IF A$<>"0123456789012345678901234567890123456789" THEN N=N+1:IF N=1 THEN B$=A$
1560 NEXT
1570 CLOSE 2
1580 IF N=0 THEN PRINT "OK"
1590 IF N>0 THEN PRINT "BAD LINES";N:F=F+1:IF F$="" THEN F$="5"
1595 IF N>0 THEN PRINT "  GOT:[";B$;"]"
1597 IF N>0 AND H=1 AND L=1 THEN 1890
1600 REM ---- DIRECTORY ----
1610 PRINT "6 DIR     ";
1620 OPEN 1,D,0,"$"
1630 N=0
1640 GET#1,A$
1650 IF ST=0 THEN N=N+1:GOTO 1640
1660 CLOSE 1
1670 PRINT N;"BYTES"
1680 IF N<32 THEN F=F+1:IF F$="" THEN F$="6"
1700 REM ---- SCRATCH ----
1710 PRINT "7 SCRATCH ";
1720 PRINT#15,"S0:TESTSEQ"
1730 GOSUB 900
1740 PRINT E$
1750 IF EN<>1 THEN F=F+1:IF F$="" THEN F$="7"
1760 PRINT "8 GONE    ";
1770 OPEN 2,D,2,"0:TESTSEQ,S,R"
1780 GOSUB 900
1790 CLOSE 2
1800 IF EN=62 THEN PRINT "OK"
1810 IF EN<>62 THEN PRINT "UNEXPECTED ";E$:F=F+1:IF F$="" THEN F$="8"
1820 PRINT#15,"S0:TESTBIG"
1830 GOSUB 900
1890 CLOSE 15
1899 RETURN
3000 REM ---- START MENU: F1-F7 CHANGE, RETURN OR 8 S STARTS ----
3010 PRINT CHR$(147);"PRIFLOP IEC SELF TEST"
3020 PRINT "-----------------"
3030 PRINT "F1 DRIVE ......";D;
3040 IF D=9 THEN PRINT "(RAM)";
3050 PRINT
3060 PRINT "F3 BIG FILE ...";S;"LINES,";INT(S*41/1024);"KB"
3070 IF L=0 THEN PRINT "F5 ROUNDS ..... ONE"
3080 IF L=1 THEN PRINT "F5 ROUNDS ..... LOOP UNTIL Q"
3090 IF H=1 THEN PRINT "F7 ON FAILURE . STOP, KEEP FILES"
3100 IF H=0 THEN PRINT "F7 ON FAILURE . COUNT, GO ON"
3110 PRINT
3112 PRINT "USAGE"
3114 PRINT " F1 DRIVE 8, OR 9 = RAM DRIVE: TESTS"
3116 PRINT "    THE BUS WITHOUT WRITING TO FLASH"
3118 PRINT " F3 BIG FILE 200/1000/1800 LINES"
3120 PRINT " F5 ONE ROUND, OR LOOP WITH A COUNTER;"
3122 PRINT "    Q BETWEEN ROUNDS STOPS THE LOOP"
3124 PRINT " F7 STOP AT THE FIRST FAILURE AND KEEP"
3126 PRINT "    TESTSEQ/TESTBIG, OR COUNT AND GO ON"
3128 PRINT " NO KEY: ONE ROUND ON 8 - THE GATE TEST"
3130 PRINT
3132 PRINT "RETURN STARTS. STARTING IN ";
3134 T0=TI:C=-1
3140 GET K$
3142 C1=8-INT((TI-T0)/60)
3144 IF C1<>C AND C1>0 THEN C=C1:PRINT CHR$(48+C);CHR$(157);
3150 IF K$=CHR$(13) THEN PRINT:RETURN
3160 IF K$=CHR$(133) THEN D=17-D:GOTO 3010
3170 IF K$=CHR$(134) THEN S=S+800:IF S>1800 THEN S=200
3175 IF K$=CHR$(134) THEN 3010
3180 IF K$=CHR$(135) THEN L=1-L:GOTO 3010
3190 IF K$=CHR$(136) THEN H=1-H:GOTO 3010
3200 IF TI-T0<480 THEN 3140
3210 PRINT:RETURN
3500 REM ---- WAIT UP TO 3 S FOR A KEY, K$ = THE KEY OR "" ----
3510 T0=TI
3520 GET K$
3530 IF K$<>"" THEN RETURN
3540 IF TI-T0<180 THEN 3520
3550 RETURN
